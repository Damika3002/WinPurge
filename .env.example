# WinPurge v1.0 Configuration Template
# Copy this file to .env in the same folder as winpurge.bat to configure custom settings.

# Set to 1 to automatically confirm the initial start prompt (unattended run)
AUTO_CONFIRM=0

# Set to 1 to permanently skip emptying the Recycle Bin
SKIP_RECYCLE_BIN=0

# Set to 1 to skip flushing the Windows Prefetch cache
SKIP_PREFETCH=0

# Set to 1 to disable ANSI color formatting
NO_COLOR=0
